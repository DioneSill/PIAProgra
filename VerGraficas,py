import matplotlib.pyplot as plt
import numpy as np
from datetime import datetime

terremotos = [
    {"magnitud": 2.5, "profundidad": 10},
    {"magnitud": 4.2, "profundidad": 35},
    {"magnitud": 6.1, "profundidad": 70}
]
#Categoria por terremotos
def categoriater():
    fuerte = 0
    moderado = 0
    leve = 0 
    for terremoto in terremotos:
        magnitud = terremoto["magnitud"]
        if magnitud < 4:
            leve += 1
        elif 4 <= magnitud < 6:
            moderado += 1
        else:
            fuerte += 1
    mylabels = ["Leves <4", "Moderados 4-6", "Fuertes >6"]
    y = np.array([leve, moderado, fuerte])

    ahora = datetime.now()
    nombre = ahora.strftime("%Y-%m-%d-%H-%M")

    plt.pie(y, labels=mylabels, autopct='%1.1f%%')
    plt.title("Categoría de terremotos")

    plt.savefig(f"proyecto/Graficas/grafica_{nombre}.png")
    plt.show()


categoriater()

